<!DOCTYPE html>
<html lang="en">
  <head>
     <meta charset ="UTF-8">
     <meta content="width=device-width, initial-scale=1.0" name="viewport">
     <title>Code Practice Studio</title>
     <style>
       
     </style>
  </head>
  <body>
    <header>
      <div class="brand">
        <div class="logo">&lt;/&gt;</div>
        <div>
          <h1>Code Practice Studio</h1>
          <p>Your reference on the left. Your practice on the right</p>
        </div>
      </div>
      <div class="top-actions">
        <span class="status" id="connectionStatus">
          <i class="dot offline" id="statusDot"> </i>
          <span id="statusText">Checking editor...</span>
        </span>
        <button class ="hide-mobile" id="newWorkspace">+New Workspace</button>
      </div>
    </header> 
      <main>
        <div class="toolbar">
          <div class="toolbar-left">
            <label class="field">
               Workspace
               <select aria-label="Select workspace" id="workspaceSelect"></select>
            </label>  
            <label class="field">
               Name
               <input 
                 id="workspaceName"
                 maxlength="48"
                 value="JavaScript practice"
               >
            </label>
            <label class="field">
               Language
               <select id="language">
                 <option value="javascript">JavaScript</option>  
                 <option value="python">Python</option>
                 <option value="htmlmixed">HTML</option>
                 <option value="css">CSS</option>
                 <option value="clike">C</option>
                 <option value="cpp">C++</option>
                 <option value="rust">Rust</option>
                 <option value="java">Java</option>
                 <option value="php">PHP</option>
                 <option value="sql">SQL</option>
                 <option value="shell">Shell</option>
                 <option value="json">JSON</option>
                 <option value="xml">XML</option>
                 <option value="markdown">MARKDOWN</option>
                 <option value="plaintext">Plain text</option>
               </select>
            </label>
          </div>
          <div class="toolbar-right">
            <button
             aria-pressed="false"
             id="focusToggle"
             title="Hide the reference and focus on your practice(Alt+shift+f)"
             >Focus mode
            </button>
            <button aria-pressed="false" id="compareToggle">Compare: off</button>
            <button id="fontDown" title="Decrease editor text size">A-</button>
            <button
              class="danger"
              id="deleteWorkspace"
              title="Delete this workspace"
             >
                Delete workspace
            </button>
          </div>  
        </div>  
        <section class="panes">
          <article class="pane reference">
             <div class="paane-head">
               <div class="pane-title">
                 <span>📖</span>
                 <div>
                   <strong>Reference program</strong>
                   <small>Paste or type the code you want to study</small>
                 </div>
               </div>
               <div class="pane-tools">
                 <button 
                   id="formatReference" 
                   title="Format indentation, spacing, and line breaks"
                 >
                   Format code
                 </button>
                 <button id="foldAllReference"
                   id="unfoldAllReferenced"
                   title="Expand all sections in the reference editor"
                 >
                  Unfold all
                 </button>
                 <button
                   id="autoFormatReferenced"
                   title="Automatically format code when pasted"
                  >
                   Auto-format: off 
                 </button>
                 <button id="clearReference">Clear</button>
                 <button id="copyReference">Copy</button>
               </div>
             </div>
             <div class="editor-wrap">
               <div class="editor-host" id="referenceHost">
                 <textarea
                    class="editor-fallback"
                    id="referenceFallback"
                    placeholder="Paste your reference code heere..."
                    spellcheck="false"
                  ></textarea>  
               </div>  
             </div>
             <div class="pane-foot">
               <span id="freferenceLanguage">JAVASCRIP</span>
               <SPAN ID="REFERENCECount">0 lines . 0 chars</span>
             </div> 
          </article>
        </section>
      </main>
  </body>
</html>
